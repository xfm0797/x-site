{# 企业主题归档页：按年份分组的案例列表 #}
{% extends "base.tera" %}

{% block title %}{{ "案例归档" }} - {{ site.title }}{% endblock %}

{% block content %}
<section class="archive-section">
  <h1 class="page-title">{{ "案例归档" }}</h1>
  <p class="page-subtitle">{{ "按时间倒序展示所有案例" }}</p>

  {% for group in groups %}
  <div class="archive-year">
    <h2 class="year-title">{{ group.0 }}</h2>
    <div class="archive-list">
      {% for post in group.1 %}
      <article class="archive-item">
        <a href="{{ post.url }}" class="archive-cover">
          {% if post.cover %}
          <img src="/{{ post.cover }}" alt="{{ post.title }}" loading="lazy">
          {% else %}
          <div class="cover-fallback"></div>
          {% endif %}
        </a>
        <div class="archive-body">
          <h3><a href="{{ post.url }}">{{ post.title }}</a></h3>
          {% if post.category %}<span class="archive-cat">{{ post.category }}</span>{% endif %}
          <p class="archive-excerpt">{{ post.excerpt }}</p>
          <time class="archive-date">{{ post.created_at }}</time>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</section>
{% endblock %}
