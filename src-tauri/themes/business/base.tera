{# 企业主题全站布局 #}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ site.title }}{% endblock %}</title>
  <meta name="description" content="{{ site.description }}">
  <meta name="author" content="{{ site.author }}">
  <link rel="stylesheet" href="/assets/css/style.css">
  {% if site.logo %}
  <link rel="icon" href="/{{ site.logo }}">
  {% endif %}
  {% block head_extra %}{% endblock %}
</head>
<body>
  {# ===== 页头：Logo + 导航 ===== #}
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">
        {% if site.logo %}
        <img src="/{{ site.logo }}" alt="{{ site.title }}" class="brand-logo">
        {% else %}
        <span class="brand-name">{{ site.title }}</span>
        {% endif %}
      </a>
      <nav class="main-nav">
        <a href="/">{{ "首页" }}</a>
        <a href="/archive.html">{{ "案例" }}</a>
        <a href="/links.html">{{ "合作伙伴" }}</a>
        <a href="/#contact">{{ "联系我们" }}</a>
      </nav>
    </div>
  </header>

  {# ===== 自定义页头 HTML（广告/公告/统计） ===== #}
  {% if site.header_html %}
  <div class="site-header-html">{{ site.header_html | safe }}</div>
  {% endif %}

  {# ===== 页头广告位 ===== #}
  {% if site.ads.header_html %}
  <div class="ad-slot ad-header">{{ site.ads.header_html | safe }}</div>
  {% endif %}

  {# ===== 主内容区 ===== #}
  <main class="site-main">
    <div class="container">
      {% block content %}{% endblock %}
    </div>
    {% if site.ads.sidebar_html %}
    <aside class="ad-slot ad-sidebar">{{ site.ads.sidebar_html | safe }}</aside>
    {% endif %}
  </main>

  {# ===== 页尾：联系信息 + 友链 + 备案 ===== #}
  <footer class="site-footer" id="contact">
    <div class="container footer-grid">
      <div class="footer-col">
        <h4>{{ site.title }}</h4>
        <p>{{ site.description }}</p>
      </div>
      <div class="footer-col">
        <h4>{{ "快速导航" }}</h4>
        <ul>
          <li><a href="/">{{ "首页" }}</a></li>
          <li><a href="/archive.html">{{ "案例" }}</a></li>
          <li><a href="/links.html">{{ "合作伙伴" }}</a></li>
        </ul>
      </div>
      {% if site.links.len > 0 %}
      <div class="footer-col">
        <h4>{{ "友情链接" }}</h4>
        <ul>
          {% for link in site.links %}
          <li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>
    <div class="footer-bottom">
      <p>© {{ site.year }} {{ site.author }} · Powered by x-site</p>
      {% if site.icp %}
      <p class="icp">{{ site.icp }}</p>
      {% endif %}
    </div>
  </footer>

  {# ===== 自定义页尾 HTML（统计/备案/广告） ===== #}
  {% if site.footer_html %}
  <div class="site-footer-html">{{ site.footer_html | safe }}</div>
  {% endif %}

  {# ===== 页脚广告位 ===== #}
  {% if site.ads.site_footer_html %}
  <div class="ad-slot ad-site-footer">{{ site.ads.site_footer_html | safe }}</div>
  {% endif %}

  {# ===== 评论系统接入（文章页 block 注入） ===== #}
  {% block comments %}{% endblock %}
</body>
</html>
