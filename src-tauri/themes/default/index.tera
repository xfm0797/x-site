{% extends "base.tera" %}

{% block content %}
<section class="post-list">
  {% for post in posts %}
  <article class="post-card">
    {% if post.cover %}
    <a href="{{ post.url }}" class="card-cover">
      <img src="/{{ post.cover }}" alt="{{ post.title }}" loading="lazy">
    </a>
    {% endif %}

    <div class="card-body">
      <h2 class="card-title">
        <a href="{{ post.url }}">{{ post.title }}</a>
      </h2>
      <div class="card-meta">
        <time>{{ post.created_at }}</time>
        {% if post.category %}
        <span class="card-category">{{ post.category }}</span>
        {% endif %}
      </div>
      <p class="card-excerpt">{{ post.excerpt }}</p>
      <div class="card-tags">
        {% for tag in post.tags %}
        <a href="/tags/{{ tag | slugify }}.html" class="tag">#{{ tag }}</a>
        {% endfor %}
      </div>
    </div>
  </article>
  {% endfor %}
</section>

{% if total_pages > 1 %}
<nav class="pagination">
  {% if prev_url %}
  <a href="{{ prev_url }}" class="page-prev">&laquo; 上一页</a>
  {% endif %}
  <span class="page-info">{{ page }} / {{ total_pages }}</span>
  {% if next_url %}
  <a href="{{ next_url }}" class="page-next">下一页 &raquo;</a>
  {% endif %}
</nav>
{% endif %}
{% endblock %}
