{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "x-site",
  "version": "0.1.2",
  "identifier": "com.xfm0797.xsite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "x-site",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform static blog desktop client",
    "longDescription": "x-site is a Gridea-like cross-platform static blog desktop client built with Tauri v2, Vue 3, TypeScript and Rust. Author: XFM (https://github.com/xfm0797)",
    "publisher": "XFM",
    "copyright": "© 2026 XFM",

    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      },
      "wix": {
        "language": "zh-CN",
        "template": null
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },

    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": { "width": 600, "height": 400 }
      }
    },

    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libappindicator3-1"],
        "section": "devel",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },

  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/xfm0797/x-site/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwMjk3QjAzNjAyMzlEQTcKUldTbm5TTmdBM3NwME1BTWZja0pOQzZnMTZ0YWVsSXZBemdKNUVJUGZ1VXh1VFpGMWtFT3NIaEwK"
    }
  }
}
